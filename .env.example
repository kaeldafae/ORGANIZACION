# ─────────────────────────────────────────────────────────────────────────────
# Configuración de la app de incidencias. Copia este archivo como ".env" y
# rellena los valores que te dé IT. Ninguno de estos valores es secreto
# (una app web los expone siempre al navegador), pero no los subas al
# repositorio para poder cambiar de entorno sin tocar código.
# ─────────────────────────────────────────────────────────────────────────────

# "true" = modo demo (datos de ejemplo, sin login). Déjalo vacío o "false" en producción.
VITE_DEMO=false

# Identificador del directorio de la empresa (Entra ID → Información general → Id. de inquilino).
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Identificador de la aplicación registrada (Entra ID → Registros de aplicaciones → Id. de aplicación (cliente)).
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Dirección pública de la app. Debe coincidir EXACTAMENTE con el URI de redirección registrado.
# Si se deja vacío se usa la dirección desde la que se abre la app.
VITE_REDIRECT_URI=

# Dirección completa del sitio de SharePoint del equipo (sin barra final).
VITE_SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/Equipo

# Nombre exacto de la lista.
VITE_LIST_NAME=Incidencias del departamento

# Id. de objeto del grupo de Entra cuyos miembros son managers.
VITE_MANAGERS_GROUP_ID=00000000-0000-0000-0000-000000000000

# Permiso de Graph sobre sitios: "Sites.ReadWrite.All" (por defecto) o "Sites.Selected".
VITE_GRAPH_SITES_SCOPE=Sites.ReadWrite.All

# Permiso de SharePoint para adjuntar fotos. Por defecto: https://<tenant>.sharepoint.com/AllSites.Write
# Déjalo vacío para usar el valor por defecto.
VITE_SHAREPOINT_SCOPE=

# Zona horaria para turnos y "Hoy".
VITE_TIMEZONE=Europe/Madrid

# Franjas de turno (hora de inicio-hora de fin, 0-24). La que cruza medianoche va al final.
VITE_TURNOS=Mañana=7-15,Tarde=15-23,Noche=23-7

# Tamaño máximo de foto en MB (después de comprimir).
VITE_MAX_FOTO_MB=5

# "path" (por defecto, para Azure Static Web Apps) o "hash" (para alojamientos sin reescritura de rutas).
VITE_ROUTER_MODE=path
